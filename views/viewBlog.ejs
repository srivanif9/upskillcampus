<!DOCTYPE html>
<html>

<head>

<meta charset="UTF-8">

<title><%= blog.title %></title>

<link rel="stylesheet" href="/css/blog.css">

</head>

<body>

<div class="container">

<h1><%= blog.title %></h1>

<p>

<b>Category:</b>

<%= blog.category %>

</p>

<p>

<b>Status:</b>

<%= blog.status %>

</p>

<p>

<b>Published:</b>

<%= blog.created_at %>

</p>

<% if(blog.featured_image){ %>

<img

src="<%= blog.featured_image %>"

style="width:100%;
max-height:400px;
object-fit:cover;
border-radius:8px;
margin:20px 0;">

<% } %>

<hr>

<div>

<%- blog.content %>

</div>

</div>
<hr>

<div>

<%- blog.content %>

</div>
<hr>

<h2>

Leave a Comment

</h2>

<form
action="/blog/<%= blog.id %>/comment"
method="POST">

<label>

Name

</label>

<input
type="text"
name="name"
required>

<br><br>

<label>

Email

</label>

<input
type="email"
name="email">

<br><br>

<label>

Comment

</label>

<textarea
name="comment"
rows="6"
required></textarea>

<br><br>

<button type="submit">

Post Comment

</button>

</form>
<hr>

<h2>

Comments

</h2>

<% if(comments.length===0){ %>

<p>

No comments yet.

</p>

<% }else{ %>

<% comments.forEach(comment=>{ %>

<div
style="border:1px solid #ddd;
padding:15px;
margin-bottom:15px;
border-radius:8px;">

<h4>

<%= comment.name %>

</h4>

<p
style="color:gray;">

<%= comment.created_at %>

</p>

<p>

<%= comment.comment %>

</p>

</div>

<% }) %>

<% } %>

</body>

</html>