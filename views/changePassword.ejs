<!DOCTYPE html>

<html>

<head>

<meta charset="UTF-8">

<title>Change Password</title>

<link rel="stylesheet" href="/css/profile.css">

</head>

<body>

<div class="container">

<h1>Change Password</h1>

<form
action="/profile/password"
method="POST">

<label>

Current Password

</label>

<input
type="password"
name="currentPassword"
required>

<br><br>

<label>

New Password

</label>

<input
type="password"
name="newPassword"
required>

<br><br>

<label>

Confirm Password

</label>

<input
type="password"
name="confirmPassword"
required>

<br><br>

<button>

Update Password

</button>

</form>

<br>

<a href="/profile">

<button>

Back

</button>

</a>

</div>

</body>

</html>