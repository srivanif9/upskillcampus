<!DOCTYPE html>
<html>

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Contact Us</title>

<link rel="stylesheet"
href="/css/contact.css">

</head>

<body>

<div class="container">

<h1>Contact Us</h1>

<p>

Have a question or feedback? Send us a message.

</p>

<form
action="/contact"
method="POST">

<label>Name</label>

<input
type="text"
name="name"
required>

<br><br>

<label>Email</label>

<input
type="email"
name="email"
required>

<br><br>

<label>Subject</label>

<input
type="text"
name="subject"
required>

<br><br>

<label>Message</label>

<textarea
name="message"
rows="8"
required></textarea>

<br><br>

<button type="submit">

Send Message

</button>

</form>

</div>

</body>

</html>