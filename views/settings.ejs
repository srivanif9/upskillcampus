<!DOCTYPE html>
<html>

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>Website Settings</title>

<link rel="stylesheet" href="/css/dashboard.css">

<style>

body {
    background: #f4f7fb;
}

.settings-container {
    max-width: 900px;
    margin: 40px auto;
    padding: 0 20px;
}

.settings-header {
    margin-bottom: 30px;
}

.settings-header h1 {
    margin-bottom: 8px;
    font-size: 30px;
}

.settings-header p {
    color: #6b7280;
}


/* =========================
   Cards
========================= */

.settings-card {
    background: white;
    padding: 28px;
    border-radius: 14px;
    margin-bottom: 25px;
    box-shadow: 0 4px 18px rgba(0,0,0,0.08);
}

.settings-card h2 {
    margin-top: 0;
    margin-bottom: 8px;
}

.card-description {
    color: #6b7280;
    margin-bottom: 25px;
}


/* =========================
   Form
========================= */

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    font-weight: 600;
    margin-bottom: 8px;
}

.form-group input,
.form-group textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 15px;
    box-sizing: border-box;
}

.form-group textarea {
    min-height: 120px;
    resize: vertical;
}

.form-group input:focus,
.form-group textarea:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37,99,235,0.12);
}


/* =========================
   Buttons
========================= */

.save-btn {
    background: #2563eb;
    color: white;
    border: none;
    padding: 12px 22px;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
}

.save-btn:hover {
    background: #1d4ed8;
}


/* =========================
   Account Management
========================= */

.account-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    border-top: 1px solid #e5e7eb;
}

.account-info h3 {
    margin: 0 0 5px;
}

.account-info p {
    margin: 0;
    color: #6b7280;
    font-size: 14px;
}

.account-btn {
    display: inline-block;
    text-decoration: none;
    padding: 10px 18px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
}


/* Change password */

.password-btn {
    background: #eef2ff;
    color: #3730a3;
}

.password-btn:hover {
    background: #e0e7ff;
}


/* Delete account */

.delete-btn {
    background: #fee2e2;
    color: #b91c1c;
}

.delete-btn:hover {
    background: #fecaca;
}


/* Warning box */

.delete-warning {
    margin-top: 20px;
    padding: 15px;
    background: #fff7ed;
    border: 1px solid #fed7aa;
    border-radius: 8px;
    color: #9a3412;
    font-size: 14px;
}


/* Mobile */

@media (max-width: 650px) {

    .account-option {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
    }

    .settings-card {
        padding: 20px;
    }

}

</style>

</head>

<body>

<div class="settings-container">

    <!-- Header -->

    <div class="settings-header">

        <h1>⚙️ Website Settings</h1>

        <p>
            Configure your website and manage your account.
        </p>

    </div>


    <!-- =========================
         Website Settings
    ========================== -->

    <div class="settings-card">

        <h2>🌐 Website Configuration</h2>

        <p class="card-description">
            Customize the basic information displayed on your website.
        </p>

        <form action="/settings" method="POST">

            <div class="form-group">

                <label>
                    Site Name
                </label>

                <input
                    type="text"
                    name="site_name"
                    placeholder="Enter your website name"
                    value="<%= settings ? settings.site_name : '' %>"
                    required>

            </div>


            <div class="form-group">

                <label>
                    Site Description
                </label>

                <textarea
                    name="site_description"
                    placeholder="Describe your website"><%= settings ? settings.site_description : '' %></textarea>

            </div>


            <button
                type="submit"
                class="save-btn">

                💾 Save Settings

            </button>

        </form>

    </div>


    <!-- =========================
         Account Management
    ========================== -->

    <div class="settings-card">

        <h2>👤 Account Management</h2>

        <p class="card-description">
            Manage your account security and account access.
        </p>


        <!-- Change Password -->

        <div class="account-option">

            <div class="account-info">

                <h3>🔐 Change Password</h3>

                <p>
                    Update your password to keep your account secure.
                </p>

            </div>

            <a
                href="/profile/password"
                class="account-btn password-btn">

                Change Password

            </a>

        </div>


        <!-- Delete Account -->

        <div class="account-option">

            <div class="account-info">

                <h3>🗑️ Delete Account</h3>

                <p>
                    Permanently delete your account and account data.
                </p>

            </div>

            <a
                href="/profile/delete"
                class="account-btn delete-btn">

                Delete Account

            </a>

        </div>


        <div class="delete-warning">

            ⚠️ <strong>Important:</strong>
            Account deletion is permanent and cannot be undone.

        </div>

    </div>

</div>

</body>

</html>