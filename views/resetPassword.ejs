<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Reset Password</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

<div class="box">

    <h2>Reset Password</h2>

    <p>
        Enter your new password below.
    </p>

    <form action="/reset-password" method="POST">

        <input
            type="hidden"
            name="token"
            value="<%= token %>"
        >

        <input
            type="password"
            name="newPassword"
            placeholder="New Password"
            minlength="8"
            required
        >

        <input
            type="password"
            name="confirmPassword"
            placeholder="Confirm New Password"
            minlength="8"
            required
        >

        <button type="submit">
            Reset Password
        </button>

    </form>

    <br>

    <a href="/login">
        Back to Login
    </a>

</div>

</body>

</html>