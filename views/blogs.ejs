<!DOCTYPE html>
<html>

<head>

<meta charset="UTF-8">

<title>My Blogs</title>

<link rel="stylesheet" href="/css/blog.css">

</head>

<body>

<div class="container">

<h1>My Blog Posts</h1>

<br>

<a href="/blogs/create">
    <button>Create New Blog</button>
</a>

<br><br>

<div class="stats">

<div class="card">
<h2><%= total %></h2>
<p>Total Blogs</p>
</div>

<div class="card">
<h2><%= published %></h2>
<p>Published</p>
</div>

<div class="card">
<h2><%= draft %></h2>
<p>Draft</p>
</div>

</div>

<br>

<form action="/blogs" method="GET">

<input
type="text"
name="search"
placeholder="Search blog title..."
value="<%= search %>">

<select name="category">

<option value="">All Categories</option>

<option
value="Technology"
<%= category==="Technology" ? "selected" : "" %>>
Technology
</option>

<option
value="Education"
<%= category==="Education" ? "selected" : "" %>>
Education
</option>

<option
value="Entertainment"
<%= category==="Entertainment" ? "selected" : "" %>>
Entertainment
</option>

<option
value="Sports"
<%= category==="Sports" ? "selected" : "" %>>
Sports
</option>

</select>

<button type="submit">
Search
</button>

</form>

<br>

<table border="1" width="100%" cellpadding="10">

<tr>

<th>ID</th>
<th>Image</th>
<th>Title</th>
<th>Category</th>
<th>Status</th>
<th>Created</th>
<th>Actions</th>

</tr>

<% blogs.forEach(blog=>{ %>

<tr>

<td><%= blog.id %></td>

<td>

<% if(blog.featured_image){ %>

<img
src="<%= blog.featured_image %>"
class="thumb">

<% }else{ %>

No Image

<% } %>

</td>

<td><%= blog.title %></td>

<td><%= blog.category %></td>

<td>

<% if(blog.status==="Published"){ %>

<span class="published">

Published

</span>

<% }else{ %>

<span class="draft">

Draft

</span>

<% } %>

</td>

<td>

<%= new Date(blog.created_at).toLocaleDateString() %>

</td>

<td>

<a href="/blog/<%= blog.slug %>">
<button type="button">
View
</button>
</a>

<a href="/blogs/edit/<%= blog.id %>">
<button type="button">
Edit
</button>
</a>

<a
href="/blogs/delete/<%= blog.id %>"
onclick="return confirm('Are you sure you want to delete this blog?')">

<button type="button">

Delete

</button>

</a>

</td>

</tr>

<% }) %>
</table>

<br>

<div class="pagination">

<% if(currentPage > 1){ %>

<a href="/blogs?page=<%= currentPage-1 %>&search=<%= search %>&category=<%= category %>">

<button>Previous</button>

</a>

<% } %>

<% for(let i=1;i<=totalPages;i++){ %>

<a href="/blogs?page=<%= i %>&search=<%= search %>&category=<%= category %>">

<button
<%= currentPage===i ? "style='background:#16a34a'" : "" %>>

<%= i %>

</button>

</a>

<% } %>

<% if(currentPage < totalPages){ %>

<a href="/blogs?page=<%= currentPage+1 %>&search=<%= search %>&category=<%= category %>">

<button>Next</button>

</a>

<% } %>

</div>

</div>

</body>

</html>